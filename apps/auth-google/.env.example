# Database
DATABASE_URL=postgresql://user:password@localhost:5432/auth_google

# Server
PORT=3000
NODE_ENV=development

CORS_ORIGIN=http://localhost:5173

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP Config (para emails de reset de contraseña)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Cartera API Config
CARTERA_API_URL=http://localhost:5000
CARTERA_USER=
CARTERA_PASSWORD=

# CRM API Config
CRM_API_URL=http://localhost:4000

# ============================================================
# Correo (@cci/email)
# ============================================================
# El paquete TIRA al importarse si le faltan RESEND_API_KEY o EMAIL_DOMAIN, y
# aun así no estaban documentados aquí: el servicio no arrancaba y no había
# forma de saber por qué desde el repo.
RESEND_API_KEY=
EMAIL_DOMAIN=servicioscashin.com
# Banners del layout. Si falta, el correo sale sin ellos (no revienta).
EMAIL_ASSETS_BASE_URL=

# ⚠️ SERVER controla a quién le llegan los correos DE VERDAD.
#   SERVER=PROD  → cada quien recibe el suyo.
#   cualquier otro valor (o vacío) → TODOS los correos se desvían a
#   EMAIL_DEV_RECIPIENT. En provisionamiento eso significa cuentas creadas
#   cuyas contraseñas nunca llegan a su dueño. El default es DEV a propósito:
#   más vale no mandar nada que mandarle a un cliente real desde una prueba.
SERVER=DEV
EMAIL_DEV_RECIPIENT=jalvarado@clubcashin.com

# ============================================================
# Provisionamiento de cuentas del portal
# ============================================================
# Secreto compartido con cartera-back para POST /internal/provisioning/*.
# Mismo valor en los dos servicios. Sin él el endpoint responde 503 y los
# inversionistas nuevos NO reciben acceso (el job diario de cartera lo reporta).
PORTAL_PROVISIONING_SECRET=
