# Database
DATABASE_URL=postgresql://user:password@localhost:5432/auth_google

# Server
PORT=3000
NODE_ENV=development

CORS_ORIGIN=http://localhost:5173

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP Config (para emails de reset de contraseña)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Cartera API Config
CARTERA_API_URL=http://localhost:5000
CARTERA_USER=
CARTERA_PASSWORD=

# CRM API Config
CRM_API_URL=http://localhost:4000

# Secreto compartido con el CRM para los endpoints /api/portal/*.
# DEBE tener el mismo valor que BETTER_SECRET_PORTAL_WEB en el CRM.
# Si no coincide, el CRM responde 401 y el portal se queda sin perfil,
# documentos, contratos ni registro de leads.
CRM_PORTAL_SECRET=

# Secreto compartido para endpoints internos servicio-a-servicio
# (p. ej. POST /api/unified/bulk-import-investors).
# Se envía como `Authorization: Bearer <secreto>`.
# Si queda vacío, esos endpoints rechazan TODAS las peticiones (fail closed).
INTERNAL_API_SECRET=
