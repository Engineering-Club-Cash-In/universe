# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# CORS
CORS_ORIGIN=http://localhost:3001
TALLER_URL=http://localhost:3000
FRONT_URL=http://localhost:3001

# Better Auth
BETTER_AUTH_SECRET=your-secret-key-here
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2 Storage
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_PUBLIC_DOMAIN=pub-e8fc0de6a599420ea473808b97217fdd.r2.dev

# R2 Buckets (standardized naming: R2_BUCKET_*)
R2_BUCKET_CRM=crm-documents
R2_BUCKET_LEGAL_DOCS=legal-documents
# Legacy names (deprecated, use R2_BUCKET_* instead)
# R2_BUCKET_NAME=crm-documents
# R2_BUCKET_NAME_LEGAL_DOCS=legal-documents

# Cartera-Back Integration
CARTERA_BACK_URL=http://localhost:7000
# Credenciales para login contra cartera-back (/auth/login). El JWT
# devuelto se cachea y refresca automáticamente.
CARTERA_USER=
CARTERA_PASSWORD=
CARTERA_BACK_TIMEOUT=30000
# Timeout aparte para el reporte de pagos no liquidados: arma el Excel completo
# del inversionista y lo sube a R2, así que no entra en los 30s por defecto.
CARTERA_BACK_REPORTE_TIMEOUT=300000
CARTERA_BACK_RETRY_ATTEMPTS=3
CARTERA_BACK_ENABLE_CACHE=true
CARTERA_BACK_CACHE_TTL=300000

# Feature Flags
ENABLE_CARTERA_BACK_INTEGRATION=false
ENABLE_CARTERA_BACK_PAYMENTS=false
ENABLE_CARTERA_BACK_SYNC_JOB=false

# Págalo — sandbox únicamente. Nunca poner token en web/.env ni en git.
PAGALO_BASE_URL=https://api.pagalodev.com
PAGALO_AUTHORIZATION=
# Mantener false. Habilitar manualmente solo para crear links de prueba.
PAGALO_LINK_CREATION_ENABLED=false

# Sync Settings
COBROS_SYNC_INTERVAL_MINUTES=60

# Tipo de cambio USD -> GTQ para convertir estados de cuenta en dólares
# en el análisis de capacidad de pago. Si no se define, se usa 7.78.
USD_EXCHANGE_RATE=7.78

# Legal Docs API
LEGAL_API_URL=https://api.devteamatcci.site
LEGAL_DOCS_API_URL=https://legal-docs-blueprints.s4.devteamatcci.site

# ── Bot de cobros por WhatsApp ────────────────────────────────────────────────
# Llave que le entregamos a SimpleTech (openssl rand -hex 32). Sin esto, todos
# los endpoints /api/bot/cobros/* responden 401.
BOT_COBROS_API_KEY=
# La llave anterior, mientras dura una rotación. Vaciar cuando SimpleTech ya use
# la nueva.
BOT_COBROS_API_KEY_PREV=
# Publica el Swagger del bot en /api/bot/cobros/docs. Solo en dev.
BOT_COBROS_DOCS=false
# Deja el OTP fijo en 4321 en vez de mandar el SMS. Solo en dev.
BOT_COBROS_OTP_SIMULADO=false
# OBLIGATORIA para el pago con boleta: dominios desde los que se acepta bajar la
# imagen, separados por coma. Falla cerrada a propósito (D-29) — vacía significa
# "no se descarga nada", así que /boleta/leer responde URL_NO_PERMITIDA a todo.
# Va el dominio del CDN de SimpleTech, el mismo de la `imagenUrl` que mandan.
BOT_COBROS_DOMINIOS_IMAGEN=
# Gemini, que es quien lee la boleta (el mismo motor del análisis bancario).
GOOGLE_GENERATIVE_AI_API_KEY=
