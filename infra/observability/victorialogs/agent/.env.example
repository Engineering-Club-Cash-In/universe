# Coolify/Docker host:
CONTAINER_SOCKET_PATH=/var/run/docker.sock

# Podman rootless local, ajustar UID si corresponde:
# CONTAINER_SOCKET_PATH=/run/user/1000/podman/podman.sock

VICTORIALOGS_ENDPOINT=https://logs.example.com/insert/elasticsearch/
LOG_HOST=app-server-01
LOG_ENVIRONMENT=staging

# Marcar como secretos en Coolify; no guardar valores reales aquí.
VECTOR_INGEST_USERNAME=replace-me
VECTOR_INGEST_PASSWORD=replace-with-at-least-24-characters
